<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- Tauri signs with the hardened runtime; the bundled Node (V8) needs JIT memory to start at all. No sandbox. -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <!-- Ad-hoc signed builds have no Team ID, so the hardened runtime would refuse to load the node-pty addon (pty.node). -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict></plist>
