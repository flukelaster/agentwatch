{
  "name": "@agentwatch/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/agentwatchd.mjs --external:node:sqlite --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\""
  },
  "dependencies": {
    "@agentwatch/protocol": "workspace:*",
    "@agentwatch/adapter-sdk": "workspace:*",
    "@agentwatch/adapter-generic-cli": "workspace:*",
    "ws": "^8.18.0",
    "@agentwatch/adapter-antigravity": "workspace:*",
    "@agentwatch/adapter-claude-code": "workspace:*",
    "@agentwatch/adapter-codex": "workspace:*",
    "@agentwatch/adapter-cursor": "workspace:*",
    "@agentwatch/adapter-gemini-cli": "workspace:*",
    "@agentwatch/setup": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0"
  }
}
